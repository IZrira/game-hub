{
  "name": "rira-game-archive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:aniimo-runtime && npm run generate:ww-runtime",
    "dev": "vite",
    "sync:notion": "node scripts/fetch-notion-data.js",
    "sync:notion-and-build": "npm run sync:notion && npm run build",
    "build": "npm run typecheck && npm run generate:search-data && npm run generate:aniimo-runtime && npm run generate:ww-runtime && node scripts/generate-sitemap.js && vite build && node scripts/prerender-meta.js && node scripts/audit-prerender-seo.js",
    "generate:aniimo-runtime": "node scripts/generate-aniimo-runtime-data.js",
    "generate:ww-runtime": "node scripts/generate-ww-runtime-data.js",
    "generate:search-data": "node scripts/generate-search-data.js",
    "preview": "vite preview",
    "prerender": "node scripts/prerender-meta.js",
    "test": "vitest run",
    "validate:data": "node scripts/validate-data.js",
    "test:e2e": "node tests/e2e/runner.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "seo:analyze": "node scripts/analyze-seo.js",
    "seo:audit": "node scripts/audit-prerender-seo.js"
  },
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/cheerio": "^1.0.0",
    "axios": "^1.15.0",
    "browser-image-compression": "^2.0.2",
    "cheerio": "^1.2.0",
    "dompurify": "^3.4.16",
    "googleapis": "^178.0.0",
    "html-to-image": "^1.11.13",
    "i18next": "^26.0.3",
    "lucide-react": "^0.564.0",
    "motion": "^12.35.1",
    "notion-to-md": "^3.1.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.2",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^20.11.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
